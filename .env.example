# =============================================================================
# NECROMANCER AI REPAIR ENGINE — FREE-TIER AI CONFIGURATION
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Then fill in your free API keys below.
# NEVER commit .env to source control! (It is already listed in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PRIMARY FREE-TIER PROVIDER: Google Gemini
# -----------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/apikey
# Free tier features: 15 RPM / 1M TPM / 1,500 requests per day at zero cost.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. BACKUP FREE-TIER PROVIDER: Groq (Ultra-fast OpenAI-compatible)
# -----------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
# Free tier features: 30 RPM / 14,400 requests per day with Llama 3.3 70B at zero cost.
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# 3. PROVIDER & MODEL SELECTION
# -----------------------------------------------------------------------------
# Default provider: "gemini" (supports "gemini", "groq", "anthropic", "openai", "mock")
NECROMANCER_LLM_PROVIDER=gemini

# Primary model (Free-tier eligible Flash & Flash-Lite models):
# Active choices: gemini-3.8-flash (recommended), gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.0-flash
NECROMANCER_LLM_MODEL=gemini-3.8-flash

# Backup Groq model (Free-tier eligible models):
# Active choices: llama-3.3-70b-versatile (recommended), llama-3.1-8b-instant, openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
NECROMANCER_GROQ_MODEL=llama-3.3-70b-versatile

# Automatic fallback from Gemini to Groq if rate-limited (HTTP 429) or unavailable
NECROMANCER_ENABLE_FALLBACK=true

# -----------------------------------------------------------------------------
# 4. SAFETY, BUDGET & ATTEMPT BOUNDS
# -----------------------------------------------------------------------------
NECROMANCER_MAX_REPAIR_ATTEMPTS=3
NECROMANCER_MAX_REPAIR_COST_USD=0.25
NECROMANCER_TIMEOUT_SECONDS=30
